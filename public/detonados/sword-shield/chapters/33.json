,"h":281,"fw":0.5}]},{"t":"p","runs":[{"t":"O corcel fugirá após a batalha e deixará cair uma mecha da crina (White Mane Hair se for Glastrier, Black Mane Hair se for Spectrier). Pegue-a para você. O prefeito irá agradecer por ter salvo o vilarejo do corcel indomável. Vá falar com Calyrex e receba dele a Radiant Petal. Com esta pétala de Calyrex e a mecha da crina do corcel será possível criar a Reins of Unity."}]},{"t":"gallery","imgs":[{"src":"img/8b7a22186a8f48e5.webp","w":500,"h":281,"fw":0.5},{"src":"img/b7314e728cf4fb7d.webp","w":500,"h":281,"fw":0.5}]},{"t":"gallery","imgs":[{"src":"img/b5547a068eb199b6.webp","w":500,"h":281,"fw":0.5},{"src":"img/22de691e1754ec31.webp","w":500,"h":281,"fw":0.5}]},{"t":"gallery","imgs":[{"src":"img/8e2dbe6e1c97cbb5.webp","w":500,"h":281,"fw":0.5},{"src":"img/67ee6ffba1a661ba.webp","w":500,"h":281,"fw":0.5}]},{"t":"gallery","imgs":[{"src":"img/a4618178a3f335b2.webp","w":500,"h":281,"fw":0.5},{"src":"img/fd8ac4b57304061f.webp","w":500,"h":281,"fw":0.5}]},{"t":"gallery","imgs":[{"src":"img/e5ceade68e776e03.webp","w":500,"h":281,"fw":0.5},{"src":"img/7ba99fa45dcd98e6.webp","w":500,"h":281,"fw":0.5}]},{"t":"gallery","imgs":[{"src":"img/8123c8b68f222332.webp","w":500,"h":281,"fw":0.5},{"src":"img/9ff99ef4ec2f81b1.webp","w":500,"h":281,"fw":0.5}]},{"t":"gallery","imgs":[{"src":"img/9498ae32ec6cac0f.webp","w":500,"h":281,"fw":0.5},{"src":"img/296fe3e1594a2b19.webp","w":500,"h":281,"fw":0.5}]},{"t":"img","src":"img/f2e2d1aaf61842ac.webp","w":500,"h":281,"fw":0.694},{"t":"p","runs":[{"t":"Vá para a cabana do prefeito e entregue os itens. Peony chegará e ajudará a fazer uma Reins of Unity para você."}]},{"t":"gallery","imgs":[{"src":"img/357195d391f6d349.webp","w":500,"h":281,"fw":0.5},{"src":"img/50ae70a77b1088dd.webp","w":500,"h":281,"fw":0.5}]},{"t":"gallery","imgs":[{"src":"img/8c6190a95f113ed3.webp","w":500,"h":281,"fw":0.5},{"src":"img/1a83469de009cff2.webp","w":500,"h":281,"fw":0.5}]},{"t":"gallery","imgs":[{"src":"img/3e8edb626e85619d.webp","w":500,"h":281,"fw":0.5},{"src":"img/7c6c198d017ad225.webp","w":500,"h":281,"fw":0.5}]},{"t":"p","runs":[{"t":"Ao sair, Calyrex irá revelar que o corcel foi para a Crown Shrine. Ele mostrará onde fica o lugar. Prepare suas melhores pokébolas e siga para lá. Chegando lá, encontre Calyrex mais uma vez. Entregue a Reins of Unity a ele. Em seguida, você deverá colocar a cenoura na cesta que Calyrex indicar. O corcel virá, Calyrex irá domá-lo e se fundir a ele. Você poderá enfrentá-lo agora."}]},{"t":"img","src":"img/f4a002ab5a9daf29.webp","w":500,"h":281,"fw":0.694},{"t":"gallery","imgs":[{"src":"img/5ea46ecd6fb03a1b.webp","w":500,"h":281,"fw":0.5},{"src":"img/64c225e3ea80abac.webp","w":500,"h":281,"fw":0.5}]},{"t":"gallery","imgs":[{"src":"img/aec8ba9388a12e8f.webp","w":500,"h":281,"fw":0.5},{"src":"img/b73d14b231f0e275.webp","w":500,"h":281,"fw":0.5}]},{"t":"gallery","imgs":[{"src":"img/21a086cbe3565352.webp","w":500,"h":281,"fw":0.5},{"src":"img/fa227e058c34b5a5.webp","w":500,"h":281,"fw":0.5}]},{"t":"gallery","imgs":[{"src":"img/1b048e993ba4c0cc.webp","w":500,"h":281,"fw":0.5},{"src":"img/f738b30760eafef4.webp","w":500,"h":281,"fw":0.5}]},{"t":"gallery","imgs":[{"src":"img/911837d4e9080d64.webp","w":500,"h":281,"fw":0.5},{"src":"img/f69d0751e75517e4.webp","w":500,"h":281,"fw":0.5}]},{"t":"img","src":"img/47bc20592fcaafba.webp","w":500,"h":281,"fw":0.694},{"t":"gallery","imgs":[{"src":"img/06bb76b12405a2ae.webp","w":500,"h":281,"fw":0.5},{"src":"img/d461fecba1c9f299.webp","w":500,"h":281,"fw":0.5}]},{"t":"gallery","imgs":[{"src":"img/c7b0bb9befbb208d.webp","w":500,"h":281,"fw":0.5},{"src":"img/21550c82cde20518.webp","w":500,"h":281,"fw":0.5}]},{"t":"gallery","imgs":[{"src":"img/dcfdda5169c698af.webp","w":500,"h":281,"fw":0.5},{"src":"img/d47603d3bc3ac0df.webp","w":500,"h":281,"fw":0.5}]},{"t":"gallery","imgs":[{"src":"img/248486d40fe0e5d3.webp","w":500,"h":281,"fw":0.5},{"src":"img/15c2ede03c796e0e.webp","w":500,"h":281,"fw":0.5}]},{"t":"img","src":"img/